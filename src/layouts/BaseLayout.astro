---
// Grundgerüst jeder Seite: SEO-Metadaten, Schrift, Cookie-Einwilligung, Header-Sprunglink.
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/components.css';
import CookieConsent from '../components/global/CookieConsent.astro';
import Motion from '../components/global/Motion.astro';
import AnnouncementBar from '../components/global/AnnouncementBar.astro';
import { site } from '../data/site';
import { noindexPaths } from '../data/seo.mjs';

interface Props {
  title: string;
  description?: string;
  path: string;
  image?: string;
  jsonLd?: Record<string, unknown>[];
  bodyClass?: string;
}
const { title, description, path, image = '/og-image.jpg', jsonLd = [], bodyClass } = Astro.props;
const canonical = path === '/' ? `${site.url}/` : `${site.url}${path}`;
const noindex = noindexPaths.includes(path);
const ogImage = new URL(image, site.url).href;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-700.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <AnnouncementBar />
    <slot />
    <CookieConsent />
    <Motion />
  </body>
</html>
