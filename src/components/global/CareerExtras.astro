---
// Karriere: Offene Stellen, Bewerben-Button, „Wir bieten dir…“ und Ablauf.
// Wird nur gezeigt, wenn in src/data/career.ts enabled: true gesetzt ist.
import { career } from '../../data/career';

const btn = career.button;
---
<section class="sec career" style="--pt:100;--pb:50;--pt-m:50;--pb-m:25">
  <div class="sec__frame"><div class="sec__cont career__inner">
    <h2 class="t head career__title" style="--fs:40;--lh:52;--fw:700;--ta:center">{career.intro.title}</h2>
    {career.intro.text.map((p) => <p class="t career__lead" style="--fs:18;--lh:27;--ta:center">{p}</p>)}
    <div class="acc career__jobs" style="--agap:12">
      {career.jobs.map((j) => (
        <details class="acc__item fr reveal" style="--f-bg:#ffffff;--f-bd:1px solid rgba(21,31,37,.12);--f-r:8px;--f-p:20px 24px">
          <summary class="acc__head">
            <span class="acc__title t" style="--fs:20;--lh:28;--fw:700">{j.title}</span>
            <span class="acc__toggle" aria-hidden="true"><svg viewBox="0 0 16 16"><path class="acc__v" d="M8 1v14"/><path d="M1 8h14"/></svg></span>
          </summary>
          <div class="acc__body t career__job" style="--fs:16;--lh:24">
            <p>📍 Arbeitsort: {j.location}<br />📋 Anstellungsart: {j.type}</p>
            <p><strong>Deine Aufgaben:</strong></p>
            <ul>{j.tasks.map((t) => <li>{t}</li>)}</ul>
            <p><strong>Dein Profil:</strong></p>
            <ul>{j.profile.map((t) => <li>{t}</li>)}</ul>
          </div>
        </details>
      ))}
    </div>
    <p class="career__cta"><a class="btn btn--volume" style="--bh:64;--bpy:9;--bpx:32;--bbg:#76b2cc;--bc:#ffffff;--br:4px;--bfs:17" href={btn.href}><span class="btn__text"><span class="btn__label">{btn.label}</span><span class="btn__sub">{btn.sub}</span></span></a></p>
  </div></div>
</section>

<section class="sec career" style="--pt:50;--pb:50;--pt-m:25;--pb-m:25">
  <div class="sec__frame"><div class="sec__cont career__inner">
    <h2 class="t head career__title" style="--fs:40;--lh:52;--fw:700;--ta:center">{career.offers.title}</h2>
    <ul class="career__offers">
      {career.offers.items.map((o) => (
        <li class="reveal">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="t" style="--fs:18;--lh:27">{o}</span>
        </li>
      ))}
    </ul>
  </div></div>
</section>

<section class="sec career" style="--pt:50;--pb:100;--pt-m:25;--pb-m:50">
  <div class="sec__frame"><div class="sec__cont career__inner">
    <ol class="career__steps">
      {career.steps.map((s, i) => (
        <li class="reveal">
          <span class="career__num" aria-hidden="true">{i + 1}</span>
          <h3 class="t" style="--fs:20;--lh:28;--fw:700">{s.title}</h3>
          <p class="t" style="--fs:16;--lh:24">{s.text}</p>
        </li>
      ))}
    </ol>
    <p class="career__cta"><a class="btn btn--volume" style="--bh:64;--bpy:9;--bpx:32;--bbg:#76b2cc;--bc:#ffffff;--br:4px;--bfs:17" href={btn.href}><span class="btn__text"><span class="btn__label">{btn.label}</span><span class="btn__sub">{btn.sub}</span></span></a></p>
  </div></div>
</section>

<style>
  .career__inner { max-width: 1000px; margin: 0 auto; }
  .career__title { margin-bottom: 16px; }
  .career__lead { max-width: 760px; margin: 0 auto 12px; }
  .career__jobs { margin-top: 32px; text-align: left; }
  .career__job ul { padding-left: 1.2em; margin: 4px 0 12px; }
  .career__cta { display: flex; justify-content: center; margin-top: 40px; }
  .career__offers { list-style: none; padding: 0; margin: 24px auto 0; max-width: 820px; display: grid; gap: 16px; }
  .career__offers li { display: grid; grid-template-columns: 28px 1fr; gap: 12px; align-items: start; }
  .career__offers svg { width: 24px; height: 24px; margin-top: 2px; color: var(--c-key1); }
  .career__steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .career__steps li { display: grid; gap: 8px; }
  .career__num { width: 48px; height: 48px; border-radius: 12px; background: var(--c-key1); color: #fff; display: grid; place-items: center; font-weight: 700; font-size: 20px; }
  @media (max-width: 767.98px) { .career__steps { grid-template-columns: 1fr; } }
</style>
