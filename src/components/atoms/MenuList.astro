---
// Liste mit Icons (Checklisten, Footer-Links, Linktree, Megamenü-Einträge).
import { Image } from 'astro:assets';
import { getImage } from '../../data/images';
import { css, fontVars } from '../../lib/style';
import { fixHref } from '../../lib/html';

interface Props { atom: any }
const { atom: a } = Astro.props;
const items: any[] = a.items || [];
const horizontal = a.dir === 'horizontal';
const space = a.space ? parseFloat(a.space) : undefined;
const centered = a.halign === 'center' && !horizontal;
// Rechtliche Links im Footer: am Desktop nebeneinander, mobil untereinander (wie bei Onepage)
const legal = items.length > 0 && items.every((it) => /\/(impressum|agb|datenschutz)$/.test(it.href || ''));
---
<ul class:list={['mlist', horizontal && 'mlist--h', centered && 'mlist--center', legal && 'mlist--legal', `mlist--${a.style || 'plain'}`]} style={css({ '--msp': horizontal ? space : 0, '--mja': a.halign === 'center' ? 'center' : undefined })}>
  {items.map((it) => {
    const href = fixHref(it.href);
    const ib = it.iconBox || {};
    const img = it.img ? getImage(it.img) : undefined;
    const pad = it.frame?.pad;
    const st = css({

      // Bild-Einträge (Megamenü): 64 × 64 px mit 12 px Radius wie bei Onepage
      '--iw': ib.w || (img ? 64 : undefined), '--is': ib.svg || undefined, '--ibg': ib.bg, '--ir': ib.radius || (img ? '12px' : undefined), '--ibd': ib.border,
      '--mig': img ? '21px' : undefined,
      '--mip': img ? '10px 10px 10px 0' : pad,
      '--ic': ib.color || it.iconColor,
    });
    const ext = href && /^https?:/.test(href);
    const inner = (
      <>
        {(it.icon || img) && (
          <span class="mlist__icon" aria-hidden="true">
            {img ? <Image src={img.src} alt="" widths={[96, 192]} sizes={`${ib.w || 64}px`} loading="lazy" /> : <Fragment set:html={it.icon} />}
          </span>
        )}
        {(it.text || it.sub) && (
          <span class="mlist__text">
            {it.text && <span class="mlist__title t" style={css(fontVars(it.font, a.itemFontM))}>{it.text}</span>}
            {it.sub && <span class="mlist__sub t" style={css(fontVars(it.subFont))}>{it.sub}</span>}
          </span>
        )}
      </>
    );
    return (
      <li>
        {href ? (
          <a class="mlist__item" style={st || undefined} href={href} target={it.target} rel={ext && it.target === '_blank' ? 'noopener' : undefined}>{inner}</a>
        ) : (
          <span class="mlist__item" style={st || undefined}>{inner}</span>
        )}
      </li>
    );
  })}
</ul>
