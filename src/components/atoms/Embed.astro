---
// Eigener Code aus Onepage (Bunny-Videos, Trustindex-Bewertungen, Artikel-HTML).
// Externe Inhalte laden – wie bisher bei Onepage – erst nach Zustimmung.
// Google-Fonts-Importe werden entfernt, die Schrift wird lokal ausgeliefert.
interface Props { atom: any }
const { atom: a } = Astro.props;
let html: string = a.source?.data?.html || '';
html = html
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/@import\s+url\(['"]?https:\/\/fonts\.googleapis\.com[^)]*\)\s*;?/g, '')
  .replace(/<link[^>]+fonts\.(googleapis|gstatic)\.com[^>]*>/g, '');
html = html.replace(/<iframe(?![^>]*\btitle=)/g, '<iframe title="Video"');
const external = /<(iframe|script)[^>]+src=["']https?:\/\//i.test(html);
const isVideo = /mediadelivery\.net|youtube|vimeo/.test(html);
const h = a.hpx ? Math.round(a.hpx) : 220;
---
{html && !external && <div class="embed" set:html={html} />}
{html && external && (
  <div class:list={['embed', isVideo && 'embed--video']} data-consent-embed style={!isVideo ? `min-height:${h}px` : undefined}>
    <div class="blocker" data-blocker>
      <svg width="20" height="24" viewBox="0 0 20 24" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M14 8h2V6.01A5.98 5.98 0 0010.01 0h-.061A5.961 5.961 0 004 5.9V8h2V5.911A3.978 3.978 0 0110.047 2h.042A3.958 3.958 0 0114 6v2zM3 10h14a3 3 0 013 3v8a3 3 0 01-3 3H3a3 3 0 01-3-3v-8a3 3 0 013-3zm5.889 8.663a2 2 0 102.222-3.325 2 2 0 00-2.222 3.325z" fill="currentColor"/></svg>
      <p class="blocker__title">Wir benötigen Ihre Zustimmung, um dieses Widget zu laden</p>
      <p class="blocker__text">Um auf die eingebetteten Inhalte zugreifen zu können, müssen Sie dem Dienst des Drittanbieters zustimmen, da dieser Daten über Ihre Aktivitäten sammeln kann.</p>
      <button type="button" class="blocker__btn" data-consent-accept>Ich bin einverstanden</button>
    </div>
    <template set:html={html} />
  </div>
)}
