---
// Fehlerseite für nicht vorhandene Adressen.
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/global/SiteHeader.astro';
---
<BaseLayout title="Seite nicht gefunden | reinkober.com" description="Diese Seite gibt es leider nicht (mehr)." path="/404">
  <SiteHeader path="/404" headings={new Map()} />
  <main id="inhalt" class="nf">
    <p class="nf__code">404</p>
    <h1 class="nf__title">Diese Seite gibt es leider nicht (mehr).</h1>
    <p class="nf__text">Vielleicht hilft Ihnen einer dieser Links weiter:</p>
    <p class="nf__links"><a class="btn btn--volume" href="/"><span class="btn__text"><span class="btn__label">Zur Startseite</span></span></a> <a class="btn btn--volume" href="/kontakt" style="--bbg:#151f25"><span class="btn__text"><span class="btn__label">Kontakt aufnehmen</span></span></a></p>
  </main>
</BaseLayout>
<style>
  .nf { max-width: 760px; margin: 0 auto; padding: 100px 24px 140px; text-align: center; }
  .nf__code { font-size: 14px; letter-spacing: .5px; text-transform: uppercase; color: #fff; background: var(--c-key1); display: inline-block; padding: 6px 12px; border-radius: 4px; }
  .nf__title { font-size: clamp(29px, 4vw, 48px); line-height: 1.28; margin: 24px 0 16px; }
  .nf__text { font-size: 18px; line-height: 27px; margin-bottom: 32px; }
  .nf__links { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
</style>
